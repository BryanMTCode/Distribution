# Copia a .env y rellena. .env NO se versiona.
#
# Todo lo que docker-compose.yml marca con `:?` es OBLIGATORIO: sin él
# `docker compose up` falla de inmediato nombrando la variable que falta. Lo
# demás tiene valor por omisión y se deja vacío si no aplica.
#
# LAS TRES CLAVES DE POSTGRESQL SE GENERAN EN HEXADECIMAL, y no es estética: las
# tres se incrustan en una URL de conexión dentro de docker-compose.yml.
# `openssl rand -base64` produce `/` y `+` más o menos la mitad de las veces, y
# libpq —el que usa el laboratorio analítico— parte mal una URI cuya contraseña
# trae `/`: intenta resolver el NOMBRE DEL ROL como si fuera el servidor y falla
# con «failed to resolve host 'dsd_analitica'», que no apunta ni de lejos a la
# causa. Peor aún, SQLAlchemy sí la tolera, así que la API arrancaría bien y solo
# el laboratorio quedaría roto. En hexadecimal el problema no existe.

# --- Base de datos -----------------------------------------------------------
DSD_DB_USUARIO=dsd
DSD_DB_PASSWORD=                      # openssl rand -hex 32

# --- Aplicación --------------------------------------------------------------
DSD_JWT_SECRETO=                      # openssl rand -hex 32  (mínimo 32 bytes)

# Sirve para correr la API A MANO fuera de compose. El despliegue con compose lo
# fija en `produccion` él mismo, sin leer esta variable, y es a propósito: es el
# valor que hace que la API no arranque sin el rol restringido de abajo. Si
# compose lo leyera de aquí, un `desarrollo` en el .env del servidor apagaría esa
# exigencia en silencio.
DSD_ENTORNO=produccion

# La zona horaria de LA OPERACIÓN, no UTC. `CURRENT_DATE` y `date.today()`
# deciden qué es «hoy»: con el reloj en UTC, en UTC−6 a partir de las 18:00
# locales «hoy» ya es mañana, el tablero del día sale vacío por la tarde y el
# arqueo no cuadra con el efectivo que la gente tiene en la mano. Desconcierta
# porque a las 11 de la mañana todo funciona.
DSD_ZONA=America/Mexico_City

# --- API: el rol restringido con el que se habla con PostgreSQL (RLS) --------
# OBLIGATORIO. Es el rol que hace que las políticas por renglón de la migración
# 0022 SIRVAN: el dueño de una tabla salta sus propias políticas, así que la API
# se conecta con `dsd_api`, que no es dueño de nada y no tiene BYPASSRLS. En
# produccion la API NO ARRANCA sin esto, a propósito: con el rol dueño, RLS
# queda escrita y sin efecto, y un teléfono vería la cartera completa.
#
# El servicio `roles` de docker-compose aplica `server/db/ops/rol_api.sql` con
# esta clave después de las migraciones. A mano:
#   psql -d dsd -v clave_api="$DSD_CLAVE_API" -f server/db/ops/rol_api.sql
DSD_CLAVE_API=                        # openssl rand -hex 32

# --- Laboratorio analítico (rol de PostgreSQL de SOLO LECTURA) ---------------
# Mismo servicio `roles` lo aplica. A mano:
#   psql -d dsd -v clave_analitica="$DSD_CLAVE_ANALITICA" \
#        -f server/db/ops/rol_analitico.sql
DSD_CLAVE_ANALITICA=                  # openssl rand -hex 32

# --- Los dos nombres con los que se entra -----------------------------------
# Caddy resuelve TLS solo contra Let's Encrypt, así que estos nombres tienen que
# apuntar (DNS tipo A) a la IP del servidor ANTES de levantar: el certificado se
# emite validando que el nombre resuelve aquí.
#
# Son dos a propósito: el laboratorio analítico es de solo lectura y no comparte
# superficie con la operación.
DSD_DOMINIO_API=api.tudominio.com
DSD_DOMINIO_ANALITICA=analitica.tudominio.com

# --- Cloudflare Tunnel: OPCIONAL --------------------------------------------
# Solo para un servidor EN LA OFICINA, que no tiene IP fija ni puertos abiertos.
# En un VPS se deja vacío: tiene IP pública y Caddy se encarga del TLS.
#
# Si lo usas, el túnel va detrás de un perfil y hay que pedirlo:
#   docker compose --profile tunel up -d
DSD_TUNNEL_TOKEN=

# --- Opcionales (vacío = apagado) --------------------------------------------
# Vacío: /metrics no existe (404). Ponerlo solo si hay un monitor que lo lea.
DSD_METRICAS_TOKEN=
# Vacío: Sentry apagado. Activarlo manda errores a un tercero: es una decisión,
# no un ajuste. Ver docs/SEGURIDAD-OPERATIVA.md.
DSD_SENTRY_DSN=
# Aparece en /salud y en la bitácora de arranque. Sirve para saber qué está
# corriendo cuando alguien pregunta por teléfono.
DSD_VERSION=0.1.0
